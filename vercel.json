{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/release-v65/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/release-v65/styles.css",
      "destination": "/styles.css"
    },
    {
      "source": "/release-v65/theme.js",
      "destination": "/theme.js"
    },
    {
      "source": "/release-v65/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/tafe-tools",
      "destination": "/tafe-tools.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/advisor",
      "destination": "/advisor.html"
    },
    {
      "source": "/atar-calculator",
      "destination": "/atar-calculator.html"
    },
    {
      "source": "/my-plan",
      "destination": "/my-plan.html"
    },
    {
      "source": "/plan",
      "destination": "/my-plan.html"
    },
    {
      "source": "/pathways",
      "destination": "/pathways.html"
    },
    {
      "source": "/no-atar",
      "destination": "/pathways.html"
    },
    {
      "source": "/subject-helper",
      "destination": "/subject-helper.html"
    },
    {
      "source": "/subjects",
      "destination": "/subject-helper.html"
    },
    {
      "source": "/calculator",
      "destination": "/atar-calculator.html"
    }
  ],
  "headers": [
    {
      "source": "/release-v65/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/uac-courses-lite.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/course-data/details/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
