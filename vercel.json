{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/advisor",
      "destination": "/advisor.html"
    },
    {
      "source": "/atar-calculator",
      "destination": "/atar-calculator.html"
    },
    {
      "source": "/atar-compass",
      "destination": "/advisor.html"
    },
    {
      "source": "/atar-match",
      "destination": "/advisor.html"
    },
    {
      "source": "/uac-planner",
      "destination": "/uac-planner.html"
    },
    {
      "source": "/preference-planner",
      "destination": "/uac-planner.html"
    },
    {
      "source": "/early-entry",
      "destination": "/uac-planner.html"
    },
    {
      "source": "/my-plan",
      "destination": "/my-plan.html"
    },
    {
      "source": "/pathways",
      "destination": "/pathways.html"
    },
    {
      "source": "/university-forms",
      "destination": "/university-forms.html"
    },
    {
      "source": "/forms",
      "destination": "/university-forms.html"
    },
    {
      "source": "/no-atar",
      "destination": "/pathways.html"
    },
    {
      "source": "/subject-helper",
      "destination": "/subject-helper.html"
    },
    {
      "source": "/subjects",
      "destination": "/subject-helper.html"
    },
    {
      "source": "/calculator",
      "destination": "/atar-calculator.html"
    }
  ],
  "headers": [
    {
      "source": "/uac-courses-lite.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/course-data/details/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
