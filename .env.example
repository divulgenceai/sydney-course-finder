# Preferred local provider. Leave AI_PROVIDER unset to use the automatic
# Ollama -> Groq -> Gemini fallback order.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_TIMEOUT_MS=120000

# Hosted fallbacks. Add keys only in .env or the deployment environment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional controls.
GEMINI_DISABLE_SEARCH=0
OFFICIAL_RESEARCH_DISABLE=0
AI_PROVIDER_LABEL=
