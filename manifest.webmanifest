{
  "name": "Sydney Course Finder",
  "short_name": "Course Finder",
  "description": "Find Sydney uni courses, ATAR matches, subject plans and no-ATAR pathways.",
  "id": "/?app=sydney-course-finder",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Planning tools",
      "short_name": "Tools",
      "url": "/tools",
      "icons": [{ "src": "/assets/app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "ATAR calculator",
      "short_name": "ATAR",
      "url": "/atar-calculator",
      "icons": [{ "src": "/assets/app-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Subject helper",
      "short_name": "Subjects",
      "url": "/subject-helper",
      "icons": [{ "src": "/assets/app-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
